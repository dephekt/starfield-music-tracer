# Applies only under tools/StarfieldExplore/ (partial Program files use flush-left static methods on purpose).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
# Leave indentation to the repo’s partial-class style; use `dotnet format whitespace` to normalize later if desired.
